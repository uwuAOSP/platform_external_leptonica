package {
    default_applicable_licenses: ["external_leptonica_license"],
    default_visibility: ["//visibility:public"],
}

license {
    name: "external_leptonica_license",
    license_kinds: ["SPDX-license-identifier-BSD-2-Clause"],
    license_text: ["leptonica-license.txt"],
}

cc_library_static {
    name: "libleptonica",
    srcs: ["src/**/*.c"],
    export_include_dirs: ["src"],
    cflags: [
        "-DANDROID_BUILD",
        "-DHAVE_LIBPNG=1",
        "-DHAVE_LIBZ=1",
        "-DHAVE_LIBJPEG=0",
        "-DHAVE_LIBTIFF=0",
        "-DHAVE_LIBGIF=0",
        "-DHAVE_LIBUNGIF=0",
        "-DHAVE_LIBWEBP=0",
        "-DHAVE_LIBWEBP_ANIM=0",
        "-DHAVE_LIBJP2K=0",
        "-Wno-unused-parameter",
        "-Wno-unused-function",
    ],
    shared_libs: [
        "libpng",
        "libz",
    ],
}
